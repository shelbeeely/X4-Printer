# Copy to .env (docker compose reads it automatically) and fill in, then
# `docker compose up -d --build` (or restart if already running) to pick
# up changes. See docs/setup-pi.md.

# CUPS queue name for your real printer (`lpstat -p` to list, after
# pi-server/install/docker-host-setup.sh + lpadmin) -- printing is a no-op
# until this is set.
FOCUSINK_CUPS_QUEUE=

# Friendly name shown in print dialogs.
FOCUSINK_PRINTER_NAME=Focusink

# Admin web console password -- leave empty to keep it disabled entirely
# (no admin listener starts without one, see docs/security.md).
FOCUSINK_ADMIN_PASSWORD=

# Optional remote (away-from-home) approval relay -- see docs/relay.md.
FOCUSINK_RELAY_URL=
FOCUSINK_RELAY_ACCOUNT_ID=
FOCUSINK_RELAY_ACCOUNT_TOKEN=

FOCUSINK_RETENTION_DAYS=30
FOCUSINK_LOG_LEVEL=INFO
