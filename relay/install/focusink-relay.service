[Unit]
Description=Focusink cloud relay (approval store-and-forward)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=focusink-relay
Group=focusink-relay
ExecStart=/opt/focusink-relay/.venv/bin/python -m relay_server.server
WorkingDirectory=/opt/focusink-relay
Restart=on-failure
RestartSec=5

Environment=FOCUSINK_RELAY_DATA_DIR=/var/lib/focusink-relay
Environment=FOCUSINK_RELAY_HOST=0.0.0.0
Environment=FOCUSINK_RELAY_PORT=8843
# Point these at a real certificate (e.g. Let's Encrypt via certbot) if this
# process terminates TLS itself. If you run it behind nginx/caddy instead,
# leave these empty and terminate TLS at the reverse proxy — see
# docs/relay.md "Deployment options".
Environment=FOCUSINK_RELAY_TLS_CERT=
Environment=FOCUSINK_RELAY_TLS_KEY=
Environment=FOCUSINK_RELAY_RETENTION_DAYS=14
Environment=FOCUSINK_RELAY_LOG_LEVEL=INFO

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/focusink-relay
ProtectHome=true

[Install]
WantedBy=multi-user.target
