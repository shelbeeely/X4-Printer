[Unit]
Description=Xteink X4 print inbox cloud relay (approval store-and-forward)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xteink-relay
Group=xteink-relay
ExecStart=/opt/xteink-relay/.venv/bin/python -m relay_server.server
WorkingDirectory=/opt/xteink-relay
Restart=on-failure
RestartSec=5

Environment=XTEINK_RELAY_DATA_DIR=/var/lib/xteink-relay
Environment=XTEINK_RELAY_HOST=0.0.0.0
Environment=XTEINK_RELAY_PORT=8843
# Point these at a real certificate (e.g. Let's Encrypt via certbot) if this
# process terminates TLS itself. If you run it behind nginx/caddy instead,
# leave these empty and terminate TLS at the reverse proxy — see
# docs/relay.md "Deployment options".
Environment=XTEINK_RELAY_TLS_CERT=
Environment=XTEINK_RELAY_TLS_KEY=
Environment=XTEINK_RELAY_RETENTION_DAYS=14
Environment=XTEINK_RELAY_LOG_LEVEL=INFO

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xteink-relay
ProtectHome=true

[Install]
WantedBy=multi-user.target
