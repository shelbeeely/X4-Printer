# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# PlatformIO
firmware/.pio/
firmware/.cache/
# firmware/freeink-sdk is a git submodule (tracked on purpose) — see .gitmodules

# C++ host test build
firmware/test/build/

# Local data / secrets — never commit a real deployment's state
pi-server/data/
/data/
.env
*.db
*.db-wal
*.db-shm
tls/
*.pem
!firmware/test/xtc_format/fixtures/*.pem
device.json
kitchen-x4.json

# Editor/OS cruft
.DS_Store
*.swp

# Claude Code session state (agent worktrees, etc.) -- but keep the repo's
# own committed settings/hooks (.claude/settings.json, .claude/hooks/)
.claude/worktrees/
.claude/*
!.claude/settings.json
!.claude/hooks/
